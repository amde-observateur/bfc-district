# ── Port du serveur ──────────────────────────────────────
PORT=3000

# ── Secrets JWT (changez ces valeurs !) ──────────────────
JWT_SECRET=votre-secret-jwt-bfc-2024
JWT_REFRESH=votre-secret-refresh-bfc-2024

# ── MySQL OVH (décommentez et remplissez si vous avez MySQL)
# DB_HOST=votre-serveur-mysql.mysql.db
# DB_USER=votre_utilisateur
# DB_PASS=votre_mot_de_passe
# DB_NAME=votre_base_de_donnees

# ── Dossier de stockage JSON (si pas de MySQL) ────────────
DATA_DIR=./data
